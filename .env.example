# Copy to .env and adjust. The Taskfile loads .env automatically.
LASTRO_ENV=dev
LASTRO_HTTP_ADDR=:8080
LASTRO_DATABASE_URL=postgres://lastro:lastro@localhost:55432/lastro?sslmode=disable
LASTRO_LOG_LEVEL=debug
# Only Vite reads this: `task web:dev` serves here and proxies /api and /auth to LASTRO_HTTP_ADDR.
LASTRO_WEB_PORT=5173

# In dev you can turn authentication off.
# Outside LASTRO_ENV=dev the app refuses to start with this enabled.
LASTRO_AUTH_DISABLED=true

# Sign-in through an OIDC provider (ADR-0008, docs/zitadel.md). Off while the issuer is empty.
LASTRO_PUBLIC_URL=http://localhost:8080
LASTRO_OIDC_ISSUER=
# What access tokens carry in aud: in Zitadel, the project ID.
LASTRO_OIDC_AUDIENCE=
# The owner's sub; nobody else gets in.
LASTRO_OIDC_OWNER_SUBJECT=
# Scopes clients ask for, space separated, e.g. urn:zitadel:iam:org:project:id:<project>:aud
LASTRO_OIDC_SCOPES=
# The web login (a confidential Web app) and the key that seals its session: openssl rand -base64 32
LASTRO_OIDC_WEB_CLIENT_ID=
LASTRO_OIDC_WEB_CLIENT_SECRET=
LASTRO_SESSION_KEY=
# The public client of `lastro connect` (a Native app with the device code grant); it writes.
LASTRO_OIDC_CLI_CLIENT_ID=
# Other clients that may write, comma separated. Every other client, Claude's among them, only reads.
LASTRO_OIDC_WRITE_CLIENTS=

# Empty = rule-based categorization only.
LASTRO_OLLAMA_URL=http://zaros:11434
LASTRO_OLLAMA_MODEL=

# Phase 1. Pluggy Dashboard credentials and Meu Pluggy item IDs (the API does not list items).
LASTRO_PLUGGY_CLIENT_ID=
LASTRO_PLUGGY_CLIENT_SECRET=
LASTRO_PLUGGY_ITEM_IDS=

# B3 quotes from brapi.dev (optional: without a token only a few tickers answer).
LASTRO_BRAPI_TOKEN=

# Alerts pushed to Telegram (ADR-0007). Off unless both are set.
LASTRO_TELEGRAM_BOT_TOKEN=
LASTRO_TELEGRAM_CHAT_ID=
