# Copy to .env and adjust. The Taskfile loads .env automatically.
LASTRO_ENV=dev
LASTRO_HTTP_ADDR=:8080
LASTRO_DATABASE_URL=postgres://lastro:lastro@localhost:5432/lastro?sslmode=disable
LASTRO_LOG_LEVEL=debug

# In dev you can turn off Cloudflare Access verification.
# Outside LASTRO_ENV=dev the app refuses to start with this enabled.
LASTRO_AUTH_DISABLED=true
LASTRO_CF_ACCESS_TEAM_DOMAIN=
LASTRO_CF_ACCESS_AUD=

# Empty = rule-based categorization only.
LASTRO_OLLAMA_URL=http://zaros:11434
LASTRO_OLLAMA_MODEL=

# Phase 1. Pluggy Dashboard credentials and Meu Pluggy item IDs (the API does not list items).
LASTRO_PLUGGY_CLIENT_ID=
LASTRO_PLUGGY_CLIENT_SECRET=
LASTRO_PLUGGY_ITEM_IDS=

# B3 quotes from brapi.dev (optional: without a token only a few tickers answer).
LASTRO_BRAPI_TOKEN=
